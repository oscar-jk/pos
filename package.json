{
  "name": "punto-x",
  "version": "0.1.0",
  "description": "Punto X — Sistema de Facturación (POS de escritorio) por ODTeam X",
  "main": "main/main.js",
  "author": "ODTeam X",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node scripts/test.js",
    "test:node": "node --test tests/",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "^11.10.0",
    "node-forge": "1.4.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.9.3",
    "xml-crypto": "6.1.2",
    "xmllint-wasm": "5.3.0"
  },
  "build": {
    "appId": "com.odteamx.puntox",
    "productName": "Punto X",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
